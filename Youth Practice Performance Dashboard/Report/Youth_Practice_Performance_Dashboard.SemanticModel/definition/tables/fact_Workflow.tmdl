	column 'Assessment Waiting Band' =
			
			VAR Days = fact_Workflow[AssessmentWaitDays]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Days), "Not Recorded",
			        Days = 0, "0 Days / Unconfirmed",
			        Days < 0, "Invalid",
			        Days <= 7, "1–7 Days",
			        Days <= 14, "8–14 Days",
			        Days <= 30, "15–30 Days",
			        "Over 30 Days"
			    )
		lineageTag: bc746e67-241e-44cb-8164-8a10ef18c361
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Avg Referral to Assessment Days' =
			
			AVERAGEX(
			    FILTER(
			        fact_Workflow,
			        NOT ISBLANK(fact_Workflow[AssessmentWaitDays])
			            && fact_Workflow[AssessmentWaitDays] > 0
			    ),
			    fact_Workflow[AssessmentWaitDays]
			)
		lineageTag: 3f60c93e-0873-4fe9-9dc3-a95cc2b5e8c9
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition fact_Workflow = m
		mode: import
		queryGroup: Gold\Facts
		source =
				let
				    Source = silver_ActiveWorkflows,
				    Selected = Table.SelectColumns(Source, {
				        "Active Workflow Key", "Person ID", "Name of Workflow", "Level 3 Responsible Team",
				        "Level 4 Team", "Owner", "Most Recent Step", "Referral Date", "Active From",
				        "Active To", "Age at Referral", "Time from Referral to Assessment",
				        "Length of Work (days)", "First Case for SU?", "Satisfaction Survey Response"
				    }, MissingField.UseNull),
				    Renamed = Table.RenameColumns(Selected, {
				        {"Name of Workflow", "WorkflowType"},
				        {"Level 4 Team", "TeamName"},
				        {"Time from Referral to Assessment", "AssessmentWaitDays"},
				        {"Length of Work (days)", "LengthOfWorkDays"},
				        {"Most Recent Step", "WorkflowStep"}
				    }),
				    ToDate = Table.AddColumn(Renamed, "ActiveFromDate", each
				        try Date.From([Active From]) otherwise null, type nullable date),
				    ToDate2 = Table.AddColumn(ToDate, "ActiveToDate", each
				        try Date.From([Active To]) otherwise null, type nullable date),
				    FirstCase = Table.AddColumn(ToDate2, "IsFirstCase", each
				        if [#"First Case for SU?"] = null then null
				        else if Text.Upper(Text.From([#"First Case for SU?"])) = "Y"
				             or Text.Upper(Text.From([#"First Case for SU?"])) = "YES" then true
				        else if Text.Upper(Text.From([#"First Case for SU?"])) = "N"
				             or Text.Upper(Text.From([#"First Case for SU?"])) = "NO" then false
				        else null, type nullable logical),
				    Survey = Table.AddColumn(FirstCase, "SurveySent", each
				        if [Satisfaction Survey Response] = "Yes" then true
				        else if [Satisfaction Survey Response] = "No" then false
				        else null, type nullable logical),
				    JoinTeams = Table.NestedJoin(Survey, {"TeamName"},
				        dim_Teams, {"Teams Involved"}, "TeamMatch", JoinKind.LeftOuter),
				    WithTeamID = Table.ExpandTableColumn(JoinTeams, "TeamMatch", {"Team_ID"}, {"Team_ID"}),
				    Final = Table.RemoveColumns(WithTeamID, {"First Case for SU?"}),
				    UniqueCheck = if Table.RowCount(Final) = List.Count(List.Distinct(Final[Active Workflow Key]))
				        then Final else error "Workflow key is not unique. Check bronze_ActiveWorkflowsReport"
				in
				    UniqueCheck

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

