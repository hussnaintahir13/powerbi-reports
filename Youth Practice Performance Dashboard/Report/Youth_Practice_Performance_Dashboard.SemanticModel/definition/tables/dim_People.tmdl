	column 'Disability Status' =
			
			VAR DisabilityValue =
			    LOWER(TRIM(dim_People[disability] & ""))
			RETURN
			    SWITCH(
			        TRUE(),
			        DisabilityValue = "", "Not Recorded",
			        DisabilityValue IN {"unknown", "not known", "not recorded", "n/a"}, "Not Recorded",
			        DisabilityValue IN {"no", "none", "no disability"}, "No",
			        "Yes"
			    )
		lineageTag: bca9820f-1a60-41b9-8040-bc2cf8d2d244
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Participation Count Group' =
			
			VAR EventCount =
			    COUNTROWS(
			        FILTER(
			            Bridge_EventsAttended,
			            Bridge_EventsAttended[Person ID]
			                = dim_People[Person ID]
			        )
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        EventCount = 0, "No Event Recorded",
			        EventCount = 1, "1 Event Type",
			        EventCount = 2, "2 Event Types",
			        EventCount = 3, "3 Event Types",
			        "4+ Event Types"
			    )
		lineageTag: c1e851ec-64f4-4308-a542-ac4174e2249c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Authority Map Location' =
			
			VAR AuthorityName =
			    TRIM(dim_People[Authority] & "")
			RETURN
			    IF(
			        AuthorityName = "",
			        BLANK(),
			        AuthorityName & ", England, United Kingdom"
			    )
		lineageTag: 6ec61674-c0b8-46bc-970f-d83a3eae9e2a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition dim_People = m
		mode: import
		queryGroup: Gold\Dims
		source = ```
				let
				    
				    Source = gold_People_Master,
				    Selected = Table.SelectColumns(Source, {
				        "Person ID", "Display Name", "First Name", "Last Name", "DOB", "DOB Estimated",
				        "Sex - By Birth", "Gender", "Ethnicity", "Religion", "Disability", "Context",
				        "First Language", "Fluency in English", "Nationality", "Country of Birth",
				        "Authority", "District", "Ward", "Household Structure", "Tenure Type",
				        "CAF Category", "CIN Plan", "CP Plan", "LAC 20",
				        "Looked After (Section 31)", "Care Leaver (Not Section 20 or 31)",
				        "Sources Present", "Potential Conflicts"
				    }, MissingField.UseNull),
				    Typed = Table.TransformColumnTypes(Selected,
				        {{"Person ID", Int64.Type}, {"DOB", type date}}),
				    Valid = Table.SelectRows(Typed, each [Person ID] <> null),
				    // DOB-based age is a refresh-date indicator, NOT age at referral or assessment.
				    Today = Date.From(DateTime.FixedLocalNow()),
				    AddAge = Table.AddColumn(Valid, "Age At Refresh", each
				        if [DOB] = null then null else
				        Date.Year(Today) - Date.Year([DOB]) -
				        (if Date.Month(Today) < Date.Month([DOB]) or
				            (Date.Month(Today) = Date.Month([DOB]) and Date.Day(Today) < Date.Day([DOB]))
				         then 1 else 0), Int64.Type),
				    AddBand = Table.AddColumn(AddAge, "Age Band At Refresh", each
				        if [Age At Refresh] = null then "Unknown"
				        else if [Age At Refresh] < 11 then "Under 11"
				        else if [Age At Refresh] <= 15 then "11-15"
				        else if [Age At Refresh] <= 17 then "16-17"
				        else if [Age At Refresh] <= 20 then "18-20"
				        else if [Age At Refresh] <= 25 then "21-25"
				        else "Over 25", type text),
				    UniqueCheck = if Table.RowCount(AddBand) = List.Count(List.Distinct(AddBand[Person ID]))
				        then AddBand else error "dim_People has duplicate Person ID values; check silver_PeopleMaster"
				in
				    UniqueCheck
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

