	partition fact_GoalForm = m
		mode: import
		queryGroup: Gold\Facts
		source =
				let
				    Source = silver_GoalForms,
				    Selected = Table.SelectColumns(Source, {
				        "Person ID", "Form ID", "TeamName", "FormSourceStatus", "GoalsSpecified",
				        "Overall Change", "Total Earliest Progress Score",
				        "Total Latest Progress Score", "LatestAssessmentDate"
				    }),
				    Renamed = Table.RenameColumns(Selected, {
				        {"Overall Change", "ReportedOverallChange"},
				        {"Total Earliest Progress Score", "TotalEarliestScore"},
				        {"Total Latest Progress Score", "TotalLatestScore"}
				    }),
				    NormalisedChange = Table.TransformColumns(Renamed, {{"ReportedOverallChange", each
				        if _ = null then null else Text.Lower(Text.Trim(Text.From(_))), type nullable text}}),
				    AddScoreChange = Table.AddColumn(NormalisedChange, "TotalScoreChange", each
				        if [TotalEarliestScore] = null or [TotalLatestScore] = null then null
				        else [TotalLatestScore] - [TotalEarliestScore], type nullable number),
				    JoinTeams = Table.NestedJoin(AddScoreChange, {"TeamName"},
				        dim_Teams, {"Teams Involved"}, "TeamMatch", JoinKind.LeftOuter),
				    Expand = Table.ExpandTableColumn(JoinTeams, "TeamMatch", {"Team_ID"}, {"Team_ID"}),
				    UniqueCheck = if Table.RowCount(Expand) = List.Count(List.Distinct(Expand[Form ID]))
				        then Expand else error "Duplicate Form IDs in Goals Summary and Incomplete Goals sheets"
				in
				    UniqueCheck

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

