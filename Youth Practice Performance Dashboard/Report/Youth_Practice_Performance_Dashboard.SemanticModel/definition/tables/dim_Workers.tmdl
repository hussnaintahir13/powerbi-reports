table dim_Workers
	lineageTag: 050b1bb7-b3b0-4cc7-8e94-3fc8068e9b47

	column 'Worker ID'
		dataType: int64
		formatString: 0
		lineageTag: 546ab6e2-b50c-4b82-b6d9-608748ecca83
		summarizeBy: none
