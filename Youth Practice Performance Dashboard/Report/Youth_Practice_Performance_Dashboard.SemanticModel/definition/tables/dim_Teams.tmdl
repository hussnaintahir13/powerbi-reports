		annotation SummarizationSetBy = Automatic

	column Team_ID
		dataType: int64
		formatString: 0
		lineageTag: 62f91243-b2fd-4759-98a4-b7285dd77627
		summarizeBy: none
		sourceColumn: Team_ID

