table dim_EventsAttended
	lineageTag: ab58f450-520f-4c92-8d24-84a2eb79943f

	column 'Events Attended'
		dataType: string
		lineageTag: 626e4d00-9750-478a-a1ca-d0bab7003be7
		summarizeBy: none
		sourceColumn: Events Attended

		annotation SummarizationSetBy = Automatic

	column Event_ID
		dataType: int64
		formatString: 0
		lineageTag: d2090ef3-c214-4003-9b2b-856c8042752a
		summarizeBy: none
		sourceColumn: Event_ID

		annotation SummarizationSetBy = Automatic

	partition dim_EventsAttended = m
		mode: import
		source =
				let
				    Source = silver_People,
				
				    SelectedColumns = Table.SelectColumns(
				        Source, {"Events Attended"}
				    ),
				
				    SplitEvents = Table.ExpandListColumn(
				        Table.TransformColumns(
				            SelectedColumns,
				            {{"Events Attended",
				              each if _ = null then {}
				              else Text.Split(Text.From(_), ";"),
				              type list}}
				        ),
				        "Events Attended"
				    ),
				
				    Cleaned = Table.TransformColumns(
				        SplitEvents,
				        {{"Events Attended",
				          each if _ = null then null
				          else Text.Trim(Text.Clean(_)),
				          type nullable text}}
				    ),
				
				    ValidEvents = Table.SelectRows(
				        Cleaned,
				        each [Events Attended] <> null
				          and [Events Attended] <> ""
				    ),
				
				    UniqueEvents = Table.Distinct(
				        ValidEvents, {"Events Attended"}
				    ),
				
				    Sorted = Table.Sort(
				        UniqueEvents,
				        {{"Events Attended", Order.Ascending}}
				    ),
				
				    AddedID = Table.AddIndexColumn(
				        Sorted, "Event_ID", 0, 1, Int64.Type
				    )
				in
				    AddedID

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

