table dim_AllocatedWorkers
	lineageTag: 593c47e8-9b19-4f26-bad6-13bddc360df7

	column 'Allocated Workers'
		dataType: string
		lineageTag: 0264c1f8-1d32-4dc6-b305-31d1ba12d2cf
		summarizeBy: none
		sourceColumn: Allocated Workers

		annotation SummarizationSetBy = Automatic

	column Worker_ID
		dataType: int64
		formatString: 0
		lineageTag: e8c625b7-8807-4ac6-99c5-d13d494a4e41
		summarizeBy: none
		sourceColumn: Worker_ID

		annotation SummarizationSetBy = Automatic

	partition dim_AllocatedWorkers = m
		mode: import
		queryGroup: Gold\Dims
		source =
				let
				    Source = silver_PeopleWorkedWith,
				
				    SelectedColumns = Table.SelectColumns(
				        Source, {"Allocated Workers"}
				    ),
				
				    SplitWorkers = Table.ExpandListColumn(
				        Table.TransformColumns(
				            SelectedColumns,
				            {{"Allocated Workers",
				              each if _ = null then {}
				              else Text.Split(Text.From(_), ";"),
				              type list}}
				        ),
				        "Allocated Workers"
				    ),
				
				    Cleaned = Table.TransformColumns(
				        SplitWorkers,
				        {{"Allocated Workers",
				          each if _ = null then null
				          else Text.Trim(Text.Clean(_)),
				          type nullable text}}
				    ),
				
				    ValidWorkers = Table.SelectRows(
				        Cleaned,
				        each [Allocated Workers] <> null
				          and [Allocated Workers] <> ""
				    ),
				
				    UniqueWorkers = Table.Distinct(
				        ValidWorkers, {"Allocated Workers"}
				    ),
				
				    Sorted = Table.Sort(
				        UniqueWorkers,
				        {{"Allocated Workers", Order.Ascending}}
				    ),
				
				    AddedID = Table.AddIndexColumn(
				        Sorted, "Worker_ID", 0, 1, Int64.Type
				    )
				in
				    AddedID

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

