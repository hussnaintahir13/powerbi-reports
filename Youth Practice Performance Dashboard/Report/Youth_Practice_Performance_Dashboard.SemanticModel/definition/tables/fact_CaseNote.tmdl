	partition fact_CaseNote = m
		mode: import
		queryGroup: Gold\Facts
		source = ```
				let
				    Source = silver_CaseNotes,
				   
				    Selected = Table.SelectColumns(Source, {
				        "Person ID", "Worker ID", "Type of Note", "Date and Time",
				        "Age at Case Note", "Minutes Spent", "Significant event", "Finished",
				        "Copied case note", "Appended case note"
				    }, MissingField.UseNull),
				    Renamed = Table.RenameColumns(Selected, {
				        {"Type of Note", "NoteType"},
				        {"Minutes Spent", "MinutesSpent"},
				        {"Date and Time", "CaseNoteDateTime"},
				        {"Age at Case Note", "AgeAtCaseNote"}
				    }),
				    WithDate = Table.AddColumn(Renamed, "CaseNoteDate", each
				        try Date.From([CaseNoteDateTime]) otherwise null, type nullable date),
				    FlagColumns = {
				        {"Significant event", "IsSignificantEvent"},
				        {"Finished", "IsFinished"},
				        {"Copied case note", "IsCopied"},
				        {"Appended case note", "IsAppended"}
				    },
				    WithFlags = List.Accumulate(FlagColumns, WithDate, (t as table, pair as list) =>
				        Table.AddColumn(t, pair{1}, each
				            let raw = Record.Field(_, pair{0}),
				                v = if raw = null then "" else Text.Upper(Text.Trim(Text.From(raw)))
				            in if v = "Y" then true else if v = "N" then false else null,
				            type nullable logical)),
				    Final = Table.RemoveColumns(WithFlags,
				        {"Significant event", "Finished", "Copied case note", "Appended case note"})
				in
				    Final
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

