	partition fact_GoalSession = m
		mode: import
		queryGroup: Gold\Facts
		source =
				let
				    Source = silver_GoalSessions,
				    Selected = Table.SelectColumns(Source, {
				        "Person ID", "Form ID", "Goal Number", "GoalKey", "TeamName",
				        "SessionNumber", "SessionDate", "ProgressScore"
				    }),
				    JoinTeams = Table.NestedJoin(Selected, {"TeamName"},
				        dim_Teams, {"Teams Involved"}, "TeamMatch", JoinKind.LeftOuter),
				    Final = Table.ExpandTableColumn(JoinTeams, "TeamMatch", {"Team_ID"}, {"Team_ID"})
				in
				    Final

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

