	partition fact_GoalProgress = m
		mode: import
		queryGroup: Gold\Facts
		source = ```
				let
				   
				    Source = Table.SelectColumns(silver_GoalRecords,
				        {"Person ID", "Form ID", "Goal Number", "GoalKey", "Goal", "TeamName"}),
				    ByGoal = Table.Group(silver_GoalSessions, {"GoalKey"}, {
				        {"ScoredSessions", each Table.RowCount(_), Int64.Type},
				        {"FirstScore", each Table.Sort(_, {{"SessionNumber", Order.Ascending}}){0}[ProgressScore], type nullable number},
				        {"LastScore", each Table.Sort(_, {{"SessionNumber", Order.Descending}}){0}[ProgressScore], type nullable number},
				        {"FirstSessionDate", each Table.Sort(_, {{"SessionNumber", Order.Ascending}}){0}[SessionDate], type nullable date},
				        {"LastSessionDate", each Table.Sort(_, {{"SessionNumber", Order.Descending}}){0}[SessionDate], type nullable date}
				    }),
				    MergeScores = Table.NestedJoin(Source, {"GoalKey"}, ByGoal, {"GoalKey"}, "ScoreData", JoinKind.LeftOuter),
				    ExpandScores = Table.ExpandTableColumn(MergeScores, "ScoreData",
				        {"ScoredSessions", "FirstScore", "LastScore", "FirstSessionDate", "LastSessionDate"},
				        {"ScoredSessions", "FirstScore", "LastScore", "FirstSessionDate", "LastSessionDate"}),
				    WithChange = Table.AddColumn(ExpandScores, "ScoreChange", each
				        if [ScoredSessions] = null or [ScoredSessions] < 2 then null
				        else [LastScore] - [FirstScore], type nullable number),
				    WithStatus = Table.AddColumn(WithChange, "GoalChangeCategory", each
				        if [ScoreChange] = null then "Insufficient assessments"
				        else if [ScoreChange] > 0 then "Improved"
				        else if [ScoreChange] < 0 then "Declined"
				        else "No change", type text),
				    JoinTeams = Table.NestedJoin(WithStatus, {"TeamName"},
				        dim_Teams, {"Teams Involved"}, "TeamMatch", JoinKind.LeftOuter),
				    Final = Table.ExpandTableColumn(JoinTeams, "TeamMatch", {"Team_ID"}, {"Team_ID"}),
				    UniqueCheck = if Table.RowCount(Final) = List.Count(List.Distinct(Final[GoalKey]))
				        then Final else error "GoalKey is not unique in silver_GoalRecords"
				in
				    UniqueCheck
				```

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

