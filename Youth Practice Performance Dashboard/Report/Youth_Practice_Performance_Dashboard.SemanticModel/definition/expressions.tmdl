expression silver_ActiveWorkflows =
		let
		    Source = bronze_ActiveWorkflowsReport,
		    Headers = if Table.HasColumns(Source, "Active Workflow Key") then Source
		              else Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    CleanHeaders = Table.TransformColumnNames(Headers, each Text.Trim(Text.Clean(_))),
		    // The source header contains an embedded line-break; locate it by words rather than literal bytes.
		    SurveyColumns = List.Select(Table.ColumnNames(CleanHeaders),
		        each Text.Contains(_, "Satisfaction Survey", Comparer.OrdinalIgnoreCase)),
		    Renamed = if List.IsEmpty(SurveyColumns) then CleanHeaders else
		        Table.RenameColumns(CleanHeaders, {{SurveyColumns{0}, "Satisfaction Survey Response"}}),
		    Typed = Table.TransformColumns(Renamed, {
		        {"Active Workflow Key", each if _ = null then null else Text.From(_), type nullable text},
		        {"Person ID", each try Int64.From(_) otherwise null, Int64.Type},
		        {"Referral Date", each try Date.From(_) otherwise null, type nullable date},
		        {"Active From", each try DateTime.From(_) otherwise null, type nullable datetime},
		        {"Active To", each try DateTime.From(_) otherwise null, type nullable datetime},
		        {"Age at Referral", each try Int64.From(_) otherwise null, Int64.Type},
		        {"Time from Referral to Assessment", each try Number.From(_) otherwise null, type nullable number},
		        {"Length of Work (days)", each try Number.From(_) otherwise null, type nullable number}
		    }),
		    TextFields = {"Level 3 Responsible Team", "Level 4 Team", "Name of Workflow",
		        "Most Recent Step", "Owner", "Satisfaction Survey Response", "First Case for SU?"},
		    CleanText = Table.TransformColumns(Typed, List.Transform(
		        List.Intersect({TextFields, Table.ColumnNames(Typed)}), (c) =>
		            {c, (x) => if x = null then null else
		                let v = Text.Trim(Text.Clean(Text.From(x))) in if v = "" then null else v, type nullable text})),
		    Valid = Table.SelectRows(CleanText, each [Active Workflow Key] <> null and [Person ID] <> null)
		in
		    Valid
	lineageTag: 61d8f71e-bc41-44aa-b823-77da53d8eab3
	queryGroup: Silver

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression silver_GoalForms =
		let
		    // Sheet1 contains goal-form summaries; Sheet3 contains explicitly incomplete forms.
		    Standardise = (t as table, status as text, teamColumn as text) as table =>
		        let
		            Columns = Table.SelectColumns(t, {"Person ID", "Form ID", teamColumn,
		                "Goal 1", "Goal 2", "Goal 3", "Overall Change",
		                "Total Earliest Progress Score", "Total Latest Progress Score",
		                "Goal 1 Latest session date", "Goal 2 Latest session date", "Goal 3 Latest session date"},
		                MissingField.UseNull),
		            Renamed = Table.RenameColumns(Columns, {{teamColumn, "TeamName"}}),
		            Typed = Table.TransformColumns(Renamed, {
		                {"Person ID", each try Int64.From(_) otherwise null, Int64.Type},
		                {"Form ID", each try Int64.From(_) otherwise null, Int64.Type},
		                {"Total Earliest Progress Score", each try Number.From(_) otherwise null, type nullable number},
		                {"Total Latest Progress Score", each try Number.From(_) otherwise null, type nullable number},
		                {"Goal 1 Latest session date", each try Date.From(_) otherwise null, type nullable date},
		                {"Goal 2 Latest session date", each try Date.From(_) otherwise null, type nullable date},
		                {"Goal 3 Latest session date", each try Date.From(_) otherwise null, type nullable date}
		            }),
		            CleanTeam = Table.TransformColumns(Typed, {{"TeamName", each if _ = null then null else Text.Trim(Text.Clean(Text.From(_))), type nullable text}}),
		            AddStatus = Table.AddColumn(CleanTeam, "FormSourceStatus", each status, type text),
		            AddGoalCount = Table.AddColumn(AddStatus, "GoalsSpecified", each
		                List.Count(List.Select({[#"Goal 1"], [#"Goal 2"], [#"Goal 3"]},
		                    (g) => g <> null and Text.Trim(Text.From(g)) <> "")), Int64.Type),
		            AddLatestDate = Table.AddColumn(AddGoalCount, "LatestAssessmentDate", each
		                let dates = List.RemoveNulls({[#"Goal 1 Latest session date"], [#"Goal 2 Latest session date"], [#"Goal 3 Latest session date"]})
		                in if List.IsEmpty(dates) then null else List.Max(dates), type nullable date),
		            Valid = Table.SelectRows(AddLatestDate, each [Form ID] <> null and [Person ID] <> null)
		        in Valid,
		    Summary = Standardise(bronze_Goals_AllGoalsAndChange, "Goals summary", "Team Involved"),
		    Incomplete = Standardise(bronze_Goals_incompleteGoals, "Incomplete", "Team"),
		    Combined = Table.Combine({Summary, Incomplete})
		in
		    Combined
	lineageTag: 9e2b05fd-df6c-43e3-a7c0-cf33a6d1be16
	queryGroup: Silver

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression silver_GoalSessions =
		let
		    Source = silver_GoalRecords,
		
		    RequiredKeys = {
		        "Person ID", "Form ID",
		        "Goal Number", "GoalKey", "TeamName"
		    },
		
		    SessionColumns = List.Combine(
		        List.Transform({1..10}, (n) =>
		            {
		                "Session " & Text.From(n) & " Date",
		                "Session " & Text.From(n) & " Progress"
		            }
		        )
		    ),
		
		    MissingColumns = List.Difference(
		        RequiredKeys & SessionColumns,
		        Table.ColumnNames(Source)
		    ),
		
		    Checked =
		        if List.IsEmpty(MissingColumns) then Source
		        else error
		            "silver_GoalRecords is missing: " &
		            Text.Combine(MissingColumns, ", "),
		
		    // Generate one record for every goal session
		    AllSessionRecords = List.Combine(
		        List.Transform(
		            Table.ToRecords(Checked),
		            (r as record) =>
		                List.Transform(
		                    {1..10},
		                    (n as number) =>
		                        let
		                            SessionDateValue = Record.Field(
		                                r,
		                                "Session " & Text.From(n) & " Date"
		                            ),
		
		                            SessionScoreValue = Record.Field(
		                                r,
		                                "Session " & Text.From(n) & " Progress"
		                            )
		                        in
		                            [
		                                #"Person ID" =
		                                    Record.Field(r, "Person ID"),
		                                #"Form ID" =
		                                    Record.Field(r, "Form ID"),
		                                #"Goal Number" =
		                                    Record.Field(r, "Goal Number"),
		                                GoalKey =
		                                    Record.Field(r, "GoalKey"),
		                                TeamName =
		                                    Record.Field(r, "TeamName"),
		                                SessionNumber = n,
		                                SessionDate =
		                                    try Date.From(SessionDateValue)
		                                    otherwise null,
		                                ProgressScore =
		                                    try Number.From(SessionScoreValue)
		                                    otherwise null
		                            ]
		                )
		        )
		    ),
		
		    Expanded = Table.FromRecords(
		        AllSessionRecords,
		        {
		            "Person ID", "Form ID",
		            "Goal Number", "GoalKey", "TeamName",
		            "SessionNumber", "SessionDate",
		            "ProgressScore"
		        },
		        MissingField.UseNull
		    ),
		
		    ScoredSessions = Table.SelectRows(
		        Expanded,
		        each [SessionDate] <> null
		            and [ProgressScore] <> null
		    ),
		
		    Typed = Table.TransformColumnTypes(
		        ScoredSessions,
		        {
		            {"Person ID", Int64.Type},
		            {"Form ID", Int64.Type},
		            {"Goal Number", Int64.Type},
		            {"GoalKey", type text},
		            {"TeamName", type text},
		            {"SessionNumber", Int64.Type},
		            {"SessionDate", type date},
		            {"ProgressScore", type number}
		        }
		    )
		in
		    Typed
	lineageTag: 64a1ddbc-8050-4bcc-a9bf-4acfabaabf46
	queryGroup: Silver

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

expression silver_GoalRecords =
		let
		    Source = bronze_Goals_GoalsPerPerson,
		    Required = {"Person ID", "Form ID", "Goal Number", "Goal", "Team"} &
		        List.Combine(List.Transform({1..10}, (n) =>
		            {"Session " & Text.From(n) & " Date", "Session " & Text.From(n) & " Progress"})),
		    Selected = Table.SelectColumns(Source, Required, MissingField.UseNull),
		    Renamed = Table.RenameColumns(Selected, {{"Team", "TeamName"}}),
		    Typed = Table.TransformColumns(Renamed, {
		        {"Person ID", each try Int64.From(_) otherwise null, Int64.Type},
		        {"Form ID", each try Int64.From(_) otherwise null, Int64.Type},
		        {"Goal Number", each try Int64.From(_) otherwise null, Int64.Type},
		        {"TeamName", each if _ = null then null else Text.Trim(Text.Clean(Text.From(_))), type nullable text},
		        {"Goal", each if _ = null then null else Text.Trim(Text.Clean(Text.From(_))), type nullable text}
		    }),
		    Valid = Table.SelectRows(Typed, each [Person ID] <> null and [Form ID] <> null and [Goal Number] <> null),
		    AddGoalKey = Table.AddColumn(Valid, "GoalKey", each
		        Text.From([Form ID]) & "|" & Text.From([Goal Number]), type text)
		in
		    AddGoalKey
	lineageTag: 946a3fce-9da5-458d-9189-c633a61be672
