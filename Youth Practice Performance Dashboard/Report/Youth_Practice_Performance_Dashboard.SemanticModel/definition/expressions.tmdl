		    #"Valid Person IDs" = Table.SelectRows(
		        Source,
		        each [Person ID] <> null
		          and Text.Trim(Text.From([Person ID])) <> ""
		    ),
		
		    // Remove unnecessary contact information
		    #"Removed Contact Details" = Table.RemoveColumns(
		        #"Valid Person IDs",
		        {"Email Address", "Telephone"},
		        MissingField.Ignore
		    ),
		
		    // Preserve existing column naming
		    #"Renamed Columns" = Table.RenameColumns(
		        #"Removed Contact Details",
		        {{"Sex", "Sex - By Birth"}}
		    ),
		
		    // Convert date of birth
		    #"Changed Type" = Table.TransformColumnTypes(
		        #"Renamed Columns",
		        {{"DOB", type date}}
		    ),
		
		    // Ensure one row per Person ID in this extract
		    #"Removed Duplicates" = Table.Distinct(
		        #"Changed Type",
		        {"Person ID"}
		    )
		
		in
