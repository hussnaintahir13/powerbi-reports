expression silver_CaseNotes =
		let
		    Source = bronze_case_notes,
		    Headers = if Table.HasColumns(Source, "Person ID") then Source
		              else Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
		    CleanHeaders = Table.TransformColumnNames(Headers, each Text.Trim(Text.Clean(_))),
		    Types = Table.TransformColumnTypes(CleanHeaders, {
		        {"Person ID", Int64.Type}, {"Worker ID", Int64.Type},
		        {"Person Name", type text}, {"Person Last Name", type text},
		        {"Worker Name", type text}, {"Type of Note", type text},
		        {"Teams involved", type text}, {"DOB", type date},
		        {"Date and Time", type datetime}, {"Age at Case Note", Int64.Type},
		        {"Minutes Spent", type nullable number},
		        {"Postcode", type text}, {"Authority", type text},
		        {"Copied case note", type text}, {"Appended case note", type text},
		        {"Significant event", type text}, {"Finished", type text}
		    }),
		    TextFields = {"Person Name", "Person Last Name", "Worker Name", "Type of Note",
		        "Teams involved", "Sex", "Gender", "Ethnicity", "Religion", "Authority", "Postcode",
		        "Title", "Copied case note", "Appended case note", "Significant event", "Finished"},
		    CleanText = Table.TransformColumns(Types,
		        List.Transform(List.Intersect({TextFields, Table.ColumnNames(Types)}),
		            (c) => {c, (x) => if x = null then null else
		                let v = Text.Trim(Text.Clean(Text.From(x))) in if v = "" then null else v, type nullable text})),
		    Valid = Table.SelectRows(CleanText, each [Person ID] <> null and [Date and Time] <> null),
		    #"Removed Columns" = Table.RemoveColumns(Valid,{"Family ID"}),
		    #"Changed Type" = Table.TransformColumnTypes(#"Removed Columns",{{"Date and Time", type date}})
		in
		    #"Changed Type"
