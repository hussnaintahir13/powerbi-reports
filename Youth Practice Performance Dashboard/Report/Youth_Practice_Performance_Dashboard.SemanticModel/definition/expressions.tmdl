expression gold_People_Master =
		let
		    // =====================================================
		    // 1. DEFINE MASTER PERSON COLUMNS
		    // =====================================================
		
		    PersonColumns = {
		        "Person ID",
		        "First Name",
		        "Last Name",
		        "Full Name",
		        "Family ID",
		        "DOB",
		        "DOB Estimated",
		        "Sex - By Birth",
		        "Gender",
		        "Ethnicity",
		        "Religion",
		        "Disability",
		        "Context",
		        "First Language",
		        "Fluency in English",
		        "Nationality",
		        "Country of Birth",
		        "Authority",
		        "District",
		        "Ward",
		        "Postcode",
		        "Household Structure",
		        "Tenure Type",
		        "CAF Category",
		        "CIN Plan",
		        "CP Plan",
		        "LAC 20",
		        "Looked After (Section 31)",
		        "Care Leaver (Not Section 20 or 31)"
		    },
		
		    AttributeColumns =
		        List.RemoveItems(
		            PersonColumns,
		            {"Person ID"}
		        ),
		
		    // =====================================================
		    // 2. FUNCTION TO STANDARDISE PERSON DATA
		    // =====================================================
		
		    StandardisePeople = (
		        SourceTable as table,
		        RenamePairs as list,
		        Priority as number,
		        SourceName as text
		    ) as table =>
		    let
		        CleanHeaders = Table.TransformColumnNames(
		            SourceTable,
		            each Text.Trim(_)
		        ),
		
		        Renamed = List.Accumulate(
		            RenamePairs,
		            CleanHeaders,
		            (CurrentTable as table, Pair as list) =>
		                if Table.HasColumns(CurrentTable, Pair{0})
		                    and not Table.HasColumns(CurrentTable, Pair{1})
		                then
		                    Table.RenameColumns(
		                        CurrentTable,
		                        {{Pair{0}, Pair{1}}}
		                    )
		                else
		                    CurrentTable
		        ),
		
		        Selected = Table.SelectColumns(
		            Renamed,
		            PersonColumns,
		            MissingField.UseNull
		        ),
		
		        CleanText = Table.TransformColumns(
		            Selected,
		            List.Transform(
		                List.RemoveItems(
		                    PersonColumns,
		                    {"Person ID", "DOB"}
		                ),
		                (ColumnName as text) =>
		                    {
		                        ColumnName,
		                        each
		                            if _ is text then
		                                let
		                                    Value = Text.Trim(Text.Clean(_))
		                                in
		                                    if Value = "" then null else Value
		                            else
		                                _,
		                        type any
		                    }
		            )
		        ),
		
		        Typed = Table.TransformColumns(
		            CleanText,
		            {
		                {
		                    "Person ID",
		                    each try Int64.From(_) otherwise null,
		                    Int64.Type
		                },
		                {
		                    "DOB",
		                    each try Date.From(_) otherwise null,
		                    type nullable date
		                }
		            }
		        ),
		
		        ValidPeople = Table.SelectRows(
		            Typed,
		            each [Person ID] <> null
		        ),
		
		        WithPriority = Table.AddColumn(
		            ValidPeople,
		            "_Priority",
		            each Priority,
		            Int64.Type
		        ),
		
		        WithSource = Table.AddColumn(
		            WithPriority,
		            "_Source",
		            each SourceName,
		            type text
		        ),
		
		        WithCompleteness = Table.AddColumn(
		            WithSource,
		            "_Completeness",
		            each List.NonNullCount(
		                Record.ToList(
		                    Record.SelectFields(
		                        _,
		                        AttributeColumns
		                    )
		                )
		            ),
		            Int64.Type
		        )
		    in
		        WithCompleteness,
		
		    // =====================================================
		    // 3. PEOPLE WORKED WITH - PRIORITY 1
		    // =====================================================
		
		    People = StandardisePeople(silver_PeopleWorkedWith, {}, 1, "People Worked With"),
		
		    // =====================================================
		    // 4. ACTIVE WORKFLOWS - PRIORITY 2
		    // =====================================================
		
		    Workflows = StandardisePeople(
		        bronze_ActiveWorkflowsReport,
		        {
		            {"Surname", "Last Name"},
		            {"Date of Birth", "DOB"},
		            {"Sex", "Sex - By Birth"},
		            {"Post Code", "Postcode"},
		            {"DOB is Estimated?", "DOB Estimated"},
		            {
		                "Looked After Section 31",
		                "Looked After (Section 31)"
		            },
		            {
		                "Care Leaver Not Section 20 or 31",
		                "Care Leaver (Not Section 20 or 31)"
		            }
		        },
		        2,
		        "Active Workflows"
		    ),
		
		    // =====================================================
		    // 5. CASE NOTES - PRIORITY 3
		    // =====================================================
		
		    CaseNotes = StandardisePeople(
		        silver_CaseNotes,
		        {
		            {"Person Name", "First Name"},
		            {"Person Last Name", "Last Name"},
		            {"Sex", "Sex - By Birth"},
		            {"DOB is estimated", "DOB Estimated"}
		        },
		        3,
		        "Case Notes"
		    ),
		
		    // =====================================================
		    // 6. GOALS SUMMARY - PRIORITY 4
		    // =====================================================
		
		    GoalsSummary = StandardisePeople(
		        bronze_Goals_AllGoalsAndChange,
		        {
		            {"Name", "Full Name"},
		            {"Sex", "Sex - By Birth"}
		        },
		        4,
		        "Goals Summary"
		    ),
		
		    // =====================================================
		    // 7. GOALS INCOMPLETE - PRIORITY 4
		    // CORRECTED QUERY NAME
		    // =====================================================
		
		    GoalsIncomplete = StandardisePeople(
		        bronze_Goals_incompleteGoals,
		        {
		            {"Name", "Full Name"},
		            {"Sex", "Sex - By Birth"}
		        },
		        4,
		        "Goals Incomplete"
		    ),
		
		    // =====================================================
		    // 8. GOALS DETAIL - PRIORITY 4
		    // =====================================================
		
		    GoalsDetail = StandardisePeople(
		        bronze_Goals_GoalsPerPerson,
		        {
		            {"Name", "Full Name"}
		        },
		        4,
		        "Goals Detail"
		    ),
		
		    // =====================================================
		    // 9. APPEND ALL PERSON RECORDS (UNION ALL)
		    // =====================================================
		
		    Combined = Table.Combine({
		        People,
		        Workflows,
		        CaseNotes,
		        GoalsSummary,
		        GoalsIncomplete,
		        GoalsDetail
		    }),
		
		    // =====================================================
		    // 10. CONSOLIDATE TO ONE ROW PER PERSON ID
		    // =====================================================
		
		    Grouped = Table.Group(
		        Combined,
		        {"Person ID"},
		        {
		            {
		                "BestAttributes",
		                (Rows as table) as record =>
		                    let
		                        Ordered = Table.Sort(
		                            Rows,
		                            {
		                                {
		                                    "_Priority",
		                                    Order.Ascending
		                                },
		                                {
		                                    "_Completeness",
		                                    Order.Descending
		                                }
		                            }
		                        ),
		
		                        Values = List.Transform(
		                            AttributeColumns,
		                            (ColumnName as text) =>
		                                List.First(
		                                    List.RemoveNulls(
		                                        Table.Column(
		                                            Ordered,
		                                            ColumnName
		                                        )
		                                    ),
		                                    null
		                                )
		                        )
		                    in
		                        Record.FromList(
		                            Values,
		                            AttributeColumns
		                        ),
		                type record
		            },
		
		            {
		                "Sources Present",
		                (Rows as table) as text =>
		                    Text.Combine(
		                        List.Sort(
		                            List.Distinct(Rows[_Source])
		                        ),
		                        "; "
		                    ),
		                type text
		            },
		
		            {
		                "Potential Conflicts",
		                (Rows as table) as text =>
		                    Text.Combine(
		                        List.Select(
		                            {
		                                "DOB",
		                                "Gender",
		                                "Ethnicity",
		                                "Authority"
		                            },
		                            (ColumnName as text) =>
		                                List.Count(
		                                    List.Distinct(
		                                        List.RemoveNulls(
		                                            Table.Column(
		                                                Rows,
		                                                ColumnName
		                                            )
		                                        )
		                                    )
		                                ) > 1
		                        ),
		                        ", "
		                    ),
		                type text
		            }
		        }
		    ),
		
		    // =====================================================
		    // 11. EXPAND CONSOLIDATED ATTRIBUTES
		    // =====================================================
		
		    Expanded = Table.ExpandRecordColumn(
		        Grouped,
		        "BestAttributes",
		        AttributeColumns,
		        AttributeColumns
		    ),
		
		    // =====================================================
		    // 12. CREATE DISPLAY NAME
		    // =====================================================
		
		    WithDisplayName = Table.AddColumn(
		        Expanded,
		        "Display Name",
		        each
		            let
		                NameFromParts = Text.Combine(
		                    List.RemoveNulls({
		                        [First Name],
		                        [Last Name]
		                    }),
		                    " "
		                )
		            in
		                if NameFromParts <> "" then
		                    NameFromParts
		                else
		                    [Full Name],
		        type nullable text
		    ),
		
		    // =====================================================
		    // 13. FINAL COLUMN ORDER
		    // =====================================================
		
		    Final = Table.ReorderColumns(
		        WithDisplayName,
		        {"Person ID", "Display Name"}
		            & AttributeColumns
		            & {
		                "Sources Present",
		                "Potential Conflicts"
		            }
		    ),
		    #"Removed Columns" = Table.RemoveColumns(Final,{"Family ID", "Ward", "Postcode"}),
		    #"Sorted Rows" = Table.Sort(#"Removed Columns",{{"Display Name", Order.Descending}})
		
		in
		    #"Sorted Rows"
	lineageTag: 16f5057d-d377-46d5-bb4f-aa0ecfa4a502
	queryGroup: Gold

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

